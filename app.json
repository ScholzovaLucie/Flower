{
  "expo": {
    "name": "Moje Zahrada",
    "slug": "flower-watering-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8f5e9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mojezahrada.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Potřebujeme přístup ke kameře pro focení kytek.",
        "NSPhotoLibraryUsageDescription": "Potřebujeme přístup ke galerii pro výběr fotek kytek.",
        "NSPhotoLibraryAddUsageDescription": "Potřebujeme přístup ke galerii pro ukládání fotek kytek."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e8f5e9"
      },
      "package": "com.mojezahrada.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4CAF50",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Potřebujeme přístup ke galerii pro výběr fotek kytek.",
          "cameraPermission": "Potřebujeme přístup ke kameře pro focení kytek."
        }
      ]
    ]
  }
}
